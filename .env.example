# ==============================================================================
# PRAVA FINANCIAL CLOUD - PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production
# APP_URL / APP_ORIGIN is the public origin of your deployment. Required in
# production: it is used for Google OAuth redirects, emailed links and
# cross-origin (CSRF) validation.
APP_URL=https://your-domain.onrender.com
APP_ORIGIN=https://your-domain.onrender.com

# JWT Secret for Session & Authorization Tokens (Minimum 32 random characters)
JWT_SECRET=generate-a-secure-random-64-character-secret-key-here

# Super Administrator Bootstrap Password (for omambole2007@gmail.com / admin portal)
ADMIN_LOGIN_PASSWORD=your_secure_admin_password_here

# ------------------------------------------------------------------------------
# 1. EMAIL DELIVERY (OTP, Verification, CA Notifications)
# PRIMARY: SMTP transport (configured via SMTP_HOST, SMTP_USER, SMTP_PASS)
# Secondary: Resend API (if EMAIL_PROVIDER=resend and RESEND_API_KEY set)
# ------------------------------------------------------------------------------
# SMTP Configuration (PRIMARY - required for OTP delivery)
#   Set EMAIL_PROVIDER=smtp to use SMTP as the default email provider.
#   Required for production: SMTP_HOST, SMTP_USER, SMTP_PASS must be set.
#   For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
#   App passwords required for Google Workspace accounts.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-google-app-password
SMTP_FROM="Prava Security" <your-email@gmail.com>
EMAIL_FROM="Prava Security" <your-email@gmail.com>

# OTP Settings
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------------------
# 2. SUPABASE CLOUD STORAGE (Documents, PDFs, Invoices, Attachments)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=prava-documents

# ------------------------------------------------------------------------------
# 3. WEAVIATE VECTOR CLOUD (Indian Tax Law, GST Knowledge RAG & Semantic Search)
# ------------------------------------------------------------------------------
WEAVIATE_URL=https://your-cluster-url.aws.weaviate.cloud
WEAVIATE_API_KEY=your_weaviate_api_key_here
# WEAVIATE_GRPC_URL=grpc-your-cluster-url.aws.weaviate.cloud

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (One-Click Founder & CA Sign-In)
# ------------------------------------------------------------------------------
# Google Identity Services (GIS) - configured via GOOGLE_CLIENT_ID on server.
# No client secret needed in frontend code.
# For traditional OAuth 2.0 flow, also configure GOOGLE_CLIENT_SECRET.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID is optional; server provides clientId via /auth/google/config
# GOOGLE_CLIENT_SECRET=your_google_client_secret_if_using_server_flow
# GOOGLE_REDIRECT_URI=https://your-domain.onrender.com/api/auth/google/callback
# Authorized JavaScript origins must include:
#   http://localhost:3000, http://127.0.0.1:3000, https://your-production-domain.com
# Authorized redirect URIs must include:
#   https://your-domain.com/api/auth/google/callback (traditional OAuth)
# To configure in Google Cloud Console:
#   1. Go to https://console.cloud.google.com/auth/clients
#   2. Create Web application client
#   3. Add authorized origins: http://localhost:3000, http://127.0.0.1:3000, https://your-domain.com
#   4. Add authorized redirect URIs: https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE & VISION OCR (Indian GST Invoices & Chatbot)
# ------------------------------------------------------------------------------
# Recommended in Cloud: Google Gemini API Key (runs Vision OCR + Ask Prava Chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# Local / Self-Hosted Alternative (Optional, if running Ollama locally)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5vl:7b

# ------------------------------------------------------------------------------
# 6. RELATIONAL DATABASE (MySQL)
# ------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Connect any MySQL database (Railway MySQL, PlanetScale,
# AWS RDS, Aiven). The server refuses to start in production without it: the
# JSON-file fallback in .storage_cache is development-only and must never hold
# production financial data.
DATABASE_URL=mysql://user:password@host:3306/prava_db

# ------------------------------------------------------------------------------
# 7. PLAN PAYMENTS (Razorpay Checkout, including eligible UPI methods)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret