# ==============================================================================
# PRAVA FINANCIAL CLOUD - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# JWT Secret for Session & Authorization Tokens (Minimum 32 characters)
JWT_SECRET=prava-local-dev-session-signing-secret-key-32chars

# OTP & Multi-Factor Security Configuration
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Email Delivery Configuration (Default & Recommended: Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Prava Security" <onboarding@resend.dev>

# Alternative SMTP Email Delivery (if EMAIL_PROVIDER=smtp or gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password
# SMTP_FROM="Prava Security" <security@prava.in>

# Super Administrator Bootstrap Password
ADMIN_LOGIN_PASSWORD=change_this_to_a_secure_password

# Database URL (Optional - if omitted, robust persisted local JSON storage is used)
# DATABASE_URL=mysql://root:password@localhost:3306/prava

# AI & Document Processing (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Vector Database (Weaviate Cloud)
WEAVIATE_URL=https://your-cluster-url.weaviate.cloud
WEAVIATE_API_KEY=your_weaviate_api_key_here
